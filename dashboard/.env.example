# GitHub repo this dashboard reads from and commits to.
# This should point at your docs repo (solar-airplane),
# NOT this dashboard app's own repo.
GITHUB_OWNER=your-github-username-or-org
GITHUB_REPO=solar-airplane
GITHUB_BRANCH=main

# Fine-grained GitHub Personal Access Token, scoped to only the docs repo,
# with "Contents: Read and write" permission. Create at:
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# Passphrase to gate access to the dashboard (simple cookie-based auth,
# not multi-user — this is a personal tool).
DASHBOARD_PASSWORD=choose-a-passphrase
